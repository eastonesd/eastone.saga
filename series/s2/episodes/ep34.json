      "location": "yiling_battlefield",
      "characters": [
        "zhuge_liang"
      ],
      "camera": "close-up",
      "motion": "static",
      "visual": "特寫，角色眼神複雜，既有對主公手段的震驚，也有一絲敬畏，微微點頭。",
      "lines": [
        {
          "speaker": "zhuge_liang",
          "text": "東吳水師，盡殲。",
          "emo": "calm"
        }
      ],
      "key": false
    },
