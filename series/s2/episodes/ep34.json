      "location": "wu_ship",
      "characters": [
        "sun_quan"
      ],
      "camera": "wide",
      "motion": "pan_left",
      "visual": "遠景，小艇艱難逃離火場，背後是漫長的火牆，看似安全實則無路可逃。",
      "lines": [],
      "key": false
    },
    {
