      "characters": [
        "liu_bei"
      ],
      "camera": "medium",
      "motion": "static",
      "visual": "中景，角色負手而立，微風吹動衣袍，神情平靜如同在觀看一場預演好的戲劇。",
      "lines": [],
      "key": false
    },
