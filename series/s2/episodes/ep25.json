      "location": "war_tent",
      "characters": [
        "sun_shangxiang"
      ],
      "camera": "medium",
      "motion": "static",
      "visual": "She tears the letter into pieces, scattering them like snow in the wind.",
      "lines": [
        {
          "speaker": "sun_shangxiang",
          "text": "做你的春秋大夢去吧！",
          "emo": "disdain"
        }
      ],
      "key": false
    },
    {
      "id": "s05",
      "location": "war_tent",
      "characters": [
        "sun_shangxiang"
      ],
      "camera": "medium",
      "motion": "pan_left",
      "visual": "She walks toward a small, dark wooden shed used for storage.",
      "lines": [
        {
          "speaker": "sun_shangxiang",
          "text": "若要滅吳，先殺了我。",
          "emo": "sad"
        }
      ],
      "key": false
    },
    {
      "id": "s06",
      "location": "war_tent",
      "characters": [
        "sun_shangxiang"
      ],
      "camera": "close-up",
      "motion": "static",
      "visual": "She steps into the dark shed and pulls the heavy wooden door shut.",
      "lines": [
        {
          "speaker": "sun_shangxiang",
          "text": "我就在此，自囚贖罪。",
          "emo": "sad"
        }
      ],
      "key": true
    },
