      "location": "war_tent",
      "characters": [
        "sun_shangxiang"
      ],
      "camera": "medium",
      "motion": "zoom_out",
      "visual": "A woman with messy short hair stands tall, her eyes filled with cold determination.",
      "lines": [
        {
          "speaker": "sun_shangxiang",
          "text": "把這束髮，扔到大營門口。",
          "emo": "angry"
        }
      ],
      "key": false
    },
    {
      "id": "s03",
      "location": "war_tent",
      "characters": [
        "sun_shangxiang"
      ],
      "camera": "close-up",
      "motion": "static",
      "visual": "She holds a secret letter from Sun Quan, her hands trembling slightly.",
      "lines": [
        {
          "speaker": "narrator",
          "text": "孫權欲利用親情，勸她刺殺。",
          "emo": "calm"
        }
      ],
      "key": false
    },
    {
