      ],
      "camera": "close-up",
      "motion": "static",
      "visual": "A sharp dagger slices through a thick bundle of black hair, strands falling to the dusty floor.",
      "lines": [
        {
          "speaker": "sun_shangxiang",
          "text": "從此情斷，不再相欠。",
          "emo": "sad"
        }
      ],
      "key": true
    },
    {
