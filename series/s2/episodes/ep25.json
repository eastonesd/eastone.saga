      "motion": "static",
      "visual": "A flashback of a woman laughing in a garden, her long hair flowing.",
      "lines": [
        {
          "speaker": "narrator",
          "text": "昔日恩情，如影隨形。",
          "emo": "calm"
        }
      ],
      "key": false
    },
